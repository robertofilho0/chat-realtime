NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://localhost:27017/chat-realtime
CORS_ORIGIN=*

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=1d

# Anti-flood: máximo de mensagens por janela (ms) em cada conexão
MESSAGE_RATE_LIMIT=5
MESSAGE_RATE_WINDOW_MS=5000
